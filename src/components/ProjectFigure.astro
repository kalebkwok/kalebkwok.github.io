---
// Small schematics for the project cards. Colors come from CSS tokens (.fig rules in global.css).
interface Props { slug: string }
const { slug } = Astro.props;
---
{slug === 'mini-sglang' && (
  <svg class="fig" viewBox="0 0 360 150" role="img" aria-label="Radix tree: two requests share one cached system-prompt prefix; a third request with a different prompt branches from the root.">
    <defs>
      <marker id="ah-mini" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path class="arrowhead" d="M0,0 L8,4 L0,8 z" /></marker>
    </defs>
    <path class="line" d="M56,75 H78" marker-end="url(#ah-mini)" />
    <path class="line" d="M188,75 C204,75 202,34 216,34" marker-end="url(#ah-mini)" />
    <path class="line" d="M188,75 H216" marker-end="url(#ah-mini)" />
    <path class="line" d="M33,88 V116 H216" marker-end="url(#ah-mini)" />
    <rect class="box" x="10" y="62" width="46" height="26" rx="5" />
    <text x="33" y="79" text-anchor="middle">root</text>
    <rect class="box-accent" x="80" y="56" width="108" height="38" rx="6" />
    <text x="134" y="72" text-anchor="middle">system prompt</text>
    <text class="dim" x="134" y="86" text-anchor="middle">KV cached once</text>
    <rect class="box" x="218" y="18" width="128" height="32" rx="6" />
    <text x="282" y="38" text-anchor="middle">user turn · req 1</text>
    <rect class="box" x="218" y="59" width="128" height="32" rx="6" />
    <text x="282" y="79" text-anchor="middle">user turn · req 2</text>
    <rect class="box" x="218" y="100" width="128" height="32" rx="6" />
    <text x="282" y="120" text-anchor="middle">other prompt</text>
  </svg>
)}

{slug === 'heteromega' && (
  <svg class="fig" viewBox="0 0 360 150" role="img" aria-label="FFN split across two devices: the iGPU lane computes its share of gate/up columns, SiLU-multiply and down-projection rows; the NPU lane computes the rest; one reduction sums the two partial outputs.">
    <defs>
      <marker id="ah-hm" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path class="arrowhead" d="M0,0 L8,4 L0,8 z" /></marker>
      <marker id="ah-hm-acc" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path class="arrowhead-accent" d="M0,0 L8,4 L0,8 z" /></marker>
    </defs>
    <text class="dim" x="62" y="14">iGPU · ROCm kernels</text>
    <text class="dim" x="62" y="146">NPU</text>
    <path class="line" d="M36,75 H48 V34 H60" marker-end="url(#ah-hm)" />
    <path class="line" d="M48,75 V116 H60" marker-end="url(#ah-hm)" />
    <path class="line-accent" d="M140,34 H150" marker-end="url(#ah-hm-acc)" />
    <path class="line-accent" d="M222,34 H232" marker-end="url(#ah-hm-acc)" />
    <path class="line" d="M140,116 H150" marker-end="url(#ah-hm)" />
    <path class="line" d="M222,116 H232" marker-end="url(#ah-hm)" />
    <path class="line-accent" d="M292,34 H318 V61" marker-end="url(#ah-hm-acc)" />
    <path class="line" d="M292,116 H318 V89" marker-end="url(#ah-hm)" />
    <path class="line" d="M330,75 H340" marker-end="url(#ah-hm)" />
    <rect class="box" x="6" y="59" width="30" height="32" rx="5" />
    <text x="21" y="79" text-anchor="middle">x</text>
    <rect class="box-accent" x="62" y="20" width="78" height="28" rx="5" />
    <text x="101" y="38" text-anchor="middle">gate/up A</text>
    <rect class="box-accent" x="152" y="20" width="70" height="28" rx="5" />
    <text x="187" y="38" text-anchor="middle">SiLU·mul</text>
    <rect class="box-accent" x="234" y="20" width="58" height="28" rx="5" />
    <text x="263" y="38" text-anchor="middle">down A</text>
    <rect class="box" x="62" y="102" width="78" height="28" rx="5" />
    <text x="101" y="120" text-anchor="middle">gate/up B</text>
    <rect class="box" x="152" y="102" width="70" height="28" rx="5" />
    <text x="187" y="120" text-anchor="middle">SiLU·mul</text>
    <rect class="box" x="234" y="102" width="58" height="28" rx="5" />
    <text x="263" y="120" text-anchor="middle">down B</text>
    <circle class="box" cx="318" cy="75" r="12" />
    <text x="318" y="79" text-anchor="middle">+</text>
    <text class="dim" x="300" y="79" text-anchor="end">one reduction</text>
    <text x="352" y="79" text-anchor="middle">y</text>
  </svg>
)}

{slug === 'agentic-rl' && (
  <svg class="fig" viewBox="0 0 360 150" role="img" aria-label="RL loop: the agent rollout on vLLM reads and writes ChromaDB memory tools, a sandbox verifier scores each rollout, and a verl GRPO update sends new weights back to the rollout.">
    <defs>
      <marker id="ah-rl" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrowhead" d="M0,0 L8,4 L0,8 z" /></marker>
    </defs>
    <path class="line" d="M76,46 V60" marker-start="url(#ah-rl)" marker-end="url(#ah-rl)" />
    <text class="dim" x="84" y="57">read / write</text>
    <path class="line" d="M136,82 H152" marker-end="url(#ah-rl)" />
    <path class="line" d="M246,82 H260" marker-end="url(#ah-rl)" />
    <path class="line" d="M308,102 V132 H76 V104" marker-end="url(#ah-rl)" />
    <text class="dim" x="192" y="126" text-anchor="middle">updated weights</text>
    <rect class="box" x="16" y="6" width="120" height="38" rx="6" />
    <text x="76" y="22" text-anchor="middle">memory tools</text>
    <text class="dim" x="76" y="36" text-anchor="middle">ChromaDB</text>
    <rect class="box-accent" x="16" y="62" width="120" height="40" rx="6" />
    <text x="76" y="79" text-anchor="middle">agent rollout</text>
    <text class="dim" x="76" y="93" text-anchor="middle">Qwen3-8B · vLLM</text>
    <rect class="box" x="154" y="62" width="92" height="40" rx="6" />
    <text x="200" y="79" text-anchor="middle">verifier</text>
    <text class="dim" x="200" y="93" text-anchor="middle">sandbox tests</text>
    <rect class="box" x="262" y="62" width="92" height="40" rx="6" />
    <text x="308" y="79" text-anchor="middle">GRPO</text>
    <text class="dim" x="308" y="93" text-anchor="middle">verl · 8×A6000</text>
  </svg>
)}
